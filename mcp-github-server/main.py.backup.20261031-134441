# ─────────────────────────────────────────────────────────────
# LLM Utilities
# ─────────────────────────────────────────────────────────────
async def call_llm_with_retry(
    provider_name: str,
    provider_info: Dict,
    model_id: str,
    messages: List[Dict],
    temperature: float,
    max_tokens: int
) -> Dict:
    base_url = provider_info["baseUrl"].rstrip("/")
    api_key = provider_info["api_key"]
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    payload = {"model": model_id, "messages": messages, "temperature": temperature, "max_tokens": max_tokens}
    for attempt in range(MAX_RETRIES):
        try:
            start = time.perf_counter()
            resp = await state._http_client.post(f"{base_url}/chat/completions", headers=headers, json=payload)
            latency = (time.perf_counter() - start) * 1000
            if resp.status_code == 401:
                logger.error(f"API Key inválida para {provider_name}")
                return {"error": "unauthorized", "message": "API Key inválida"}
            if resp.status_code == 429:
                await asyncio.sleep(BASE_BACKOFF * (attempt + 1))
                continue
            resp.raise_for_status()
            return {"data": resp.json(), "latency_ms": latency}
        except Exception as e:
            if attempt == MAX_RETRIES - 1:
                logger.error(f"Fallo final en {provider_name}: {e}")
                return {"error": "failed", "message": str(e)}
            await asyncio.sleep(BASE_BACKOFF * (attempt + 1))
    return {"error": "failed", "message": "Tiempo de espera agotado"}

def extract_response_content(data: Dict, provider_name: str) -> str:
    choices = data.get("choices", [])
    if not choices:
        return ""
    message = choices[0].get("message", {})
    content = message.get("content", "")
    if not content or content.strip() == "":
        reasoning = message.get("reasoning", "")
        if reasoning and reasoning.strip():
            logger.info(f"{provider_name}: content vacío, usando reasoning ({len(reasoning)} chars)")
            return reasoning.strip()
        reasoning_content = message.get("reasoning_content", "")
        if reasoning_content and reasoning_content.strip():
            logger.info(f"{provider_name}: content vacío, usando reasoning_content ({len(reasoning_content)} chars)")
            return reasoning_content.strip()
    return content.strip() if content else ""

