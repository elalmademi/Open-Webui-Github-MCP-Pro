def sync_repo() -> None:
    try:
        if os.path.exists(LOCAL_REPO_PATH):
            logger.info("Actualizando repo awesome-free-llm-apis...")
            result = subprocess.run(
                ["git", "-C", LOCAL_REPO_PATH, "pull", "--ff-only"],
                capture_output=True, text=True, timeout=60
            )
            if result.returncode != 0:
                logger.warning(f"git pull falló: {result.stderr}. Reclonando...")
                subprocess.run(["rm", "-rf", LOCAL_REPO_PATH], check=True)
                _clone_repo()
            else:
                logger.info("Repo actualizado")
        else:
            _clone_repo()
    except subprocess.TimeoutExpired:
        logger.error("Timeout clonando/actualizando repo")
    except Exception as e:
        logger.error(f"Error sincronizando repo: {e}")

def _clone_repo() -> None:
    logger.info("Clonando awesome-free-llm-apis...")
    result = subprocess.run(
        ["git", "clone", "--depth", "1", REPO_URL, LOCAL_REPO_PATH],
        capture_output=True, text=True, timeout=120
    )
    if result.returncode != 0:
        raise RuntimeError(f"Failed to clone repo: {result.stderr}")
    logger.info("Repo clonado")

def parse_readme_metadata(readme_path: str) -> Dict[str, Dict]:
    metadata = {}
    try:
        with open(readme_path, "r", encoding="utf-8") as f:
            content = f.read()
        table_pattern = r"\|(?:\s*[^|]+\s*\|){3,}"
        tables = re.findall(table_pattern, content, re.MULTILINE)
        for table in tables:
            rows = [row.strip() for row in table.strip().split("\n") if row.strip()]
            if len(rows) < 2:
                continue
            headers = [h.strip().lower() for h in rows[0].split("|") if h.strip()]
            provider_idx = next((i for i, h in enumerate(headers) if "provider" in h or "name" in h), 0)
            desc_idx = next((i for i, h in enumerate(headers) if "descript" in h or "detail" in h), 1)
            for row in rows[2:]:
                cols = [c.strip() for c in row.split("|") if c.strip()]
                if len(cols) > max(provider_idx, desc_idx):
                    provider_name = cols[provider_idx]
                    description = cols[desc_idx] if desc_idx < len(cols) else ""
                    provider_name = re.sub(r"[*\[\]#]", "", provider_name).strip()
                    description = re.sub(r"[*\[\]#]", "", description).strip()
                    if provider_name and provider_name not in metadata:
                        metadata[provider_name] = {"description": description, "source": "readme"}
    except Exception as e:
        logger.warning(f"No se pudo parsear README para metadata: {e}")
    return metadata

def load_local_providers_data() -> Dict:
    sync_repo()
    if not os.path.exists(LOCAL_DATA_JSON):
        raise FileNotFoundError(f"No existe {LOCAL_DATA_JSON} tras sync_repo()")
    with open(LOCAL_DATA_JSON, "r", encoding="utf-8") as f:
        data = json.load(f)
    if os.path.exists(LOCAL_README_MD):
        readme_meta = parse_readme_metadata(LOCAL_README_MD)
        for provider in data.get("providers", []):
            name = provider.get("name")
            if name in readme_meta:
                provider["_enriched"] = readme_meta[name]
    data["_last_sync"] = int(time.time())
    data["_source"] = "local_repo"
    return data

# ─────────────────────────────────────────────────────────────
# App State (Thread-Safe)
# ─────────────────────────────────────────────────────────────
class AppState:
    def __init__(self):
        self._providers_cache: Optional[Dict] = None
        self._last_cache_time: float = 0
        self._cache_lock = asyncio.Lock()
        self._provider_metrics: Dict[str, Dict] = {}
        self._github_client: Optional[Github] = None
        self._http_client: Optional[httpx.AsyncClient] = None
        self._configured_providers: Dict[str, Dict] = {}

    async def initialize(self):
        github_token = os.getenv("GITHUB_TOKEN")
        if github_token:
            self._github_client = Github(auth=Auth.Token(github_token), timeout=30)
            try:
                user = self._github_client.get_user().login
                logger.info(f"GitHub conectado como: {user}")
            except Exception as e:
                logger.warning(f"GitHub token inválido: {e}")
                self._github_client = Github(timeout=30)
        else:
            logger.warning("GITHUB_TOKEN no configurado - modo solo lectura pública")
            self._github_client = Github(timeout=30)
        self._http_client = httpx.AsyncClient(timeout=REQUEST_TIMEOUT)
        await self._validate_api_keys()

    async def _validate_api_keys(self):
        data = await self.get_providers_data()
        for provider in data["providers"]:
            env_var = PROVIDER_ENV_MAP.get(provider["name"])
            api_key = os.getenv(env_var) if env_var else None
            no_key_required = provider["name"] in ["Kilo Code", "LLM7.io", "OVHcloud AI Endpoints"]
            if api_key or no_key_required:
                enriched = provider.get("_enriched", {})
                self._configured_providers[provider["name"]] = {
                    "baseUrl": provider["baseUrl"],
                    "api_key": api_key,
                    "models": provider["models"],
                    "category": provider["category"],
                    "no_key_required": no_key_required,
                    "env_var": env_var,
                    "_enriched": enriched,
                }
                self._provider_metrics[provider["name"]] = {"success": 0, "errors": 0, "total_latency": 0.0}
                desc = enriched.get("description", "")
                logger.info(f"Proveedor configurado: {provider['name']} {'- ' + desc[:60] if desc else ''}")

    async def shutdown(self):
        if self._http_client:
            await self._http_client.aclose()

    async def get_providers_data(self) -> Dict:
        async with self._cache_lock:
            current_time = time.time()
            if self._providers_cache is None or (current_time - self._last_cache_time) > CACHE_TTL:
                try:
                    logger.info("Cargando catálogo de modelos desde repo local...")
                    self._providers_cache = load_local_providers_data()
                    self._last_cache_time = current_time
                except Exception as e:
                    logger.error(f"Error cargando data.json local: {e}")
                    if self._providers_cache is None:
                        raise HTTPException(status_code=500, detail="Error en catálogo de modelos local.")
            return self._providers_cache

    def record_metric(self, provider: str, success: bool, latency: float):
        if provider in self._provider_metrics:
            m = self._provider_metrics[provider]
            if success:
                m["success"] += 1
                m["total_latency"] += latency
            else:
                m["errors"] += 1

    def get_best_provider(self, criteria: str) -> Optional[Dict]:
        if not self._configured_providers:
            return None
        criteria_lower = criteria.lower()
        candidates = []
        for name, info in self._configured_providers.items():
            metrics = self._provider_metrics.get(name, {})
            error_rate = metrics.get("errors", 0) / max(1, metrics.get("success", 0) + metrics.get("errors", 0))
            if error_rate > 0.5:
                continue
            score = 0
            for model in info["models"]:
                modality = model.get("modality", "").lower()
                context_str = model.get("context", "0").replace("K", "000").replace("M", "000000")
                try:
                    context = int(''.join(filter(str.isdigit, context_str)))
                except:
                    context = 0
                if any(x in criteria_lower for x in ["código", "code", "program"]):
                    if "code" in modality:
                        score += 10
                if any(x in criteria_lower for x in ["contexto", "context", "largo"]):
                    score += min(context // 10000, 50)
                if any(x in criteria_lower for x in ["rápid", "fast", "speed"]):
                    if name in ["Groq", "Cerebras", "Kilo Code"]:
                        score += 20
                enriched = info.get("_enriched", {})
                tags = enriched.get("tags", []) if isinstance(enriched.get("tags"), list) else []
                best_for = enriched.get("best_for", []) if isinstance(enriched.get("best_for"), list) else []
                if "speed" in criteria_lower and "speed" in tags:
                    score += 25
                if "código" in criteria_lower and "code" in best_for:
                    score += 20
                if "fallback" in criteria_lower and "fallback" in tags:
                    score += 15
                if "privado" in criteria_lower and enriched.get("status") == "local":
                    score += 30
            if score > 0:
                candidates.append((score, name, info))
        if not candidates:
            name = next(iter(self._configured_providers))
            return {"name": name, **self._configured_providers[name]}
        candidates.sort(key=lambda x: x[0], reverse=True)
        best = candidates[0]
        return {"name": best[1], **best[2]}

