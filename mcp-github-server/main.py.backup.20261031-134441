@app.post("/tools/buscar_repo", operation_id="buscar_repo")
async def buscar_repo(input: BuscarRepoInput):
    async def _do_search():
        repos = state._github_client.search_repositories(query=input.query)
        if repos.totalCount == 0:
            return "No se encontraron repositorios para la búsqueda."
        results = [{"nombre": r.full_name, "estrellas": r.stargazers_count} for r in repos[:5]]
        return results
    try:
        result = await github_call_with_retry(_do_search)
        return {"result": result}
    except (GitHubRateLimitError, GitHubAuthError, GitHubNotFoundError, GitHubForbiddenError, GitHubValidationError):
        raise
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Error inesperado en buscar_repo")
        raise HTTPException(status_code=500, detail=str(e))

