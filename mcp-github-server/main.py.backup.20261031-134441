@app.post("/tools/consultar_llm_externo", operation_id="consultar_llm_externo")
async def consultar_llm_externo(input: ConsultarLLMExternoInput):
    candidates = list(state._configured_providers.items())
    if input.provider_id:
        target = state._configured_providers.get(input.provider_id)
        if target:
            candidates.insert(0, (input.provider_id, target))
    for p_name, p_info in candidates:
        model_id = input.model_id or p_info["models"][0]["id"]
        messages = []
        if input.system_prompt:
            messages.append({"role": "system", "content": input.system_prompt})
        messages.append({"role": "user", "content": input.prompt})
        logger.info(f"Intentando consulta con proveedor: {p_name}...")
        result = await call_llm_with_retry(p_name, p_info, model_id, messages, input.temperatura, input.max_tokens)
        if "data" in result:
            logger.info(f"Respuesta exitosa de {p_name}")
            response_text = extract_response_content(result["data"], p_name)
            return {"provider": p_name, "model": model_id, "response": response_text}
        else:
            logger.warning(f"{p_name} falló: {result.get('message')}. Probando siguiente...")
    raise HTTPException(status_code=503, detail="Ningún proveedor de LLM respondió correctamente.")

