class GitHubRateLimitError(HTTPException):
    def __init__(self, reset_at: int | None = None):
        detail = "Límite de API GitHub alcanzado"
        if reset_at:
            detail += f". Reset: {datetime.fromtimestamp(reset_at).isoformat()}"
        super().__init__(status_code=429, detail=detail)
        self.reset_at = reset_at

class GitHubAuthError(HTTPException):
    def __init__(self, msg: str = "Token inválido o sin permisos"):
        super().__init__(status_code=401, detail=msg)

class GitHubNotFoundError(HTTPException):
    def __init__(self, resource: str):
        super().__init__(status_code=404, detail=f"Recurso no encontrado: {resource}")

class GitHubValidationError(HTTPException):
    def __init__(self, errors: list[dict]):
        msgs = "; ".join(e.get("message", "") for e in errors)
        super().__init__(status_code=422, detail=f"Validación fallida: {msgs}")

class GitHubForbiddenError(HTTPException):
    def __init__(self, reason: str):
        super().__init__(status_code=403, detail=f"Prohibido: {reason}")

# ─────────────────────────────────────────────────────────────
# GitHub Retry Utility
# ─────────────────────────────────────────────────────────────
T = TypeVar("T")

async def github_call_with_retry(
    coro_factory: Callable[[], Awaitable[T]],
    max_retries: int = MAX_RETRIES,
    base_backoff: float = BASE_BACKOFF
) -> T:
    last_exc = None
    for attempt in range(max_retries):
        try:
            return await coro_factory()
        except GithubException as e:
            last_exc = e
            status = e.status
            data = e.data or {}
            headers = getattr(e, "headers", {}) or {}
            if status == 401:
                raise GitHubAuthError(data.get("message", "Credenciales inválidas"))
            if status == 404:
                raise GitHubNotFoundError(data.get("message", "Recurso no existe"))
            if status == 422:
                raise GitHubValidationError(data.get("errors", []))
            if status == 403:
                reset_header = headers.get("X-RateLimit-Reset") or headers.get("x-ratelimit-reset")
                if reset_header and reset_header.isdigit():
                    reset_at = int(reset_header)
                    wait = max(1, reset_at - int(time.time()) + 2)
                    logger.warning(f"Rate limit GitHub. Esperando {wait}s (intento {attempt+1}/{max_retries})")
                    await asyncio.sleep(wait)
                    continue
                reason = data.get("message", "Acceso denegado")
                if isinstance(data.get("errors"), list):
                    reason = "; ".join(err.get("message", "") for err in data["errors"])
                raise GitHubForbiddenError(reason)
            if status == 429:
                retry_after = headers.get("Retry-After")
                wait = int(retry_after) if retry_after and retry_after.isdigit() else base_backoff * (attempt + 1)
                logger.warning(f"429 GitHub. Backoff {wait}s")
                await asyncio.sleep(wait)
                continue
            if 500 <= status < 600:
                await asyncio.sleep(base_backoff * (attempt + 1))
                continue
            raise HTTPException(status_code=status, detail=data.get("message", str(e)))
    raise HTTPException(status_code=500, detail=f"GitHub falló tras {max_retries} intentos: {last_exc}")

