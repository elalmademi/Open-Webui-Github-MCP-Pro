@app.post("/tools/listar_archivos_locales", operation_id="listar_archivos_locales")
async def listar_locales():
    try:
        base = Path("/app/local_docs")
        if not base.exists():
            return {"error": "Directorio /app/local_docs no existe", "files": []}
        files = []
        for f in base.rglob("*"):
            if f.is_file():
                rel = f.relative_to(base)
                files.append({
                    "name": str(rel),
                    "size": f.stat().st_size,
                    "suffix": f.suffix,
                    "modified": datetime.fromtimestamp(f.stat().st_mtime).isoformat()
                })
        return {"files": files, "count": len(files)}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/tools/leer_local", operation_id="leer_local")
async def leer_local(input: LeerLocalInput):
    try:
        base = Path("/app/local_docs").resolve()
        target = (base / input.nombre_archivo).resolve()
        if not str(target).startswith(str(base)):
            raise HTTPException(400, "Path traversal detectado: archivo fuera de /app/local_docs")
        if not target.exists():
            raise HTTPException(404, f"Archivo no encontrado: {input.nombre_archivo}")
        if not target.is_file():
            raise HTTPException(400, "No es un archivo")
        suffix = target.suffix.lower()
        if suffix == ".pdf" and HAS_PDF:
            with open(target, "rb") as f:
                reader = PyPDF2.PdfReader(f)
                text = "\n".join([p.extract_text() for p in reader.pages])
                return {"file": input.nombre_archivo, "content": text, "size": len(text)}
        if suffix == ".docx" and HAS_DOCX:
            doc = docx.Document(target)
            text = "\n".join([p.text for p in doc.paragraphs])
            return {"file": input.nombre_archivo, "content": text, "size": len(text)}
        content = target.read_text(encoding="utf-8", errors="ignore")
        return {"file": input.nombre_archivo, "content": content, "size": len(content)}
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/tools/escribir_archivo_local", operation_id="escribir_archivo_local")
async def escribir_archivo_local(input: EscribirArchivoInput):
    try:
        base = Path("/app/workspace").resolve()
        target = (base / input.ruta).resolve()
        if not str(target).startswith(str(base)):
            raise HTTPException(400, "Path traversal detectado: archivo fuera de /app/workspace")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(input.contenido, encoding="utf-8")
        return {"file": input.ruta, "status": "written", "size": len(input.contenido)}
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/tools/ejecutar_comando", operation_id="ejecutar_comando")
async def ejecutar_comando(input: EjecutarComandoInput):
    try:
        process = subprocess.run(
            input.comando,
            shell=True,
            cwd="/app/workspace",
            capture_output=True,
            text=True,
            timeout=60
        )
        return {"stdout": process.stdout, "stderr": process.stderr, "exit_code": process.returncode}
    except subprocess.TimeoutExpired:
        return {"error": "El comando tardó demasiado tiempo en ejecutarse."}
    except Exception as e:
        return {"error": str(e)}

