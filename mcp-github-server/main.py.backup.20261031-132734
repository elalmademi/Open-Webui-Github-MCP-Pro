# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
class GitHubRateLimitError(HTTPException):
    def __init__(self, reset_at: int | None = None):
        detail = "LÃ­mite de API GitHub alcanzado"
        if reset_at:
            detail += f". Reset: {datetime.fromtimestamp(reset_at).isoformat()}"
        super().__init__(status_code=429, detail=detail)
        self.reset_at = reset_at

class GitHubAuthError(HTTPException):
    def __init__(self, msg: str = "Token invÃ¡lido o sin permisos"):
        super().__init__(status_code=401, detail=msg)

class GitHubNotFoundError(HTTPException):
    def __init__(self, resource: str):
        super().__init__(status_code=404, detail=f"Recurso no encontrado: {resource}")

class GitHubValidationError(HTTPException):
    def __init__(self, errors: list[dict]):
        msgs = "; ".join(e.get("message", "") for e in errors)
        super().__init__(status_code=422, detail=f"ValidaciÃ³n fallida: {msgs}")

class GitHubForbiddenError(HTTPException):
    def __init__(self, reason: str):
        super().__init__(status_code=403, detail=f"Prohibido: {reason}")

