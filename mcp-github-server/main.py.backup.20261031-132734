@app.post("/tools/leer_local", operation_id="leer_local")
async def leer_local(input: LeerLocalInput):
    try:
        base_dir = "/app/local_docs"
        safe_path = os.path.normpath(os.path.join(base_dir, input.nombre_archivo))
        if not safe_path.startswith(base_dir):
            raise HTTPException(400, "Acceso denegado")
        if safe_path.lower().endswith(".pdf") and HAS_PDF:
            with open(safe_path, "rb") as f:
                return {"result": "\n".join([p.extract_text() for p in PyPDF2.PdfReader(f).pages])}
        if safe_path.lower().endswith(".docx") and HAS_DOCX:
            doc = docx.Document(safe_path)
            return {"result": "\n".join([p.text for p in doc.paragraphs])}
        with open(safe_path, "rb") as f:
            return {"result": f.read().decode("utf-8", errors="ignore")}
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/tools/escribir_archivo_local", operation_id="escribir_archivo_local")
async def escribir_archivo_local(input: EscribirArchivoInput):
    try:
        base_dir = "/app/workspace"
        safe_path = os.path.normpath(os.path.join(base_dir, input.ruta))
        if not safe_path.startswith(base_dir):
            raise HTTPException(400, "Intento de escritura fuera del Ã¡rea de trabajo.")
        os.makedirs(os.path.dirname(safe_path), exist_ok=True)
        with open(safe_path, "w", encoding="utf-8") as f:
            f.write(input.contenido)
        return {"result": f"âœ… Archivo escrito exitosamente en {input.ruta}"}
    except Exception as e:
        raise HTTPException(500, str(e))

