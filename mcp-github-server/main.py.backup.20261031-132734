            shell=True,
            cwd="/app/workspace", 
            capture_output=True,
            text=True,
            timeout=60
        )
        return {"stdout": process.stdout, "stderr": process.stderr, "exit_code": process.returncode}
    except subprocess.TimeoutExpired:
