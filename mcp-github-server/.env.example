# =============================================================================
# GitHub MCP Server Pro - Variables de Entorno (.env.example)
# =============================================================================
# Copia este archivo a .env y rellena SOLO las API keys que vayas a usar.
# Los proveedores marcados como [OPCIONAL] funcionan sin key (con límites).
# =============================================================================

# -----------------------------------------------------------------------------
# GITHUB (Requerido para operaciones de escritura / rate limits altos)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# PROVIDER APIS (Empresas que entrenan sus propios modelos)
# -----------------------------------------------------------------------------

# Aion Labs - Modelos especializados en roleplay/storytelling
# Registro: https://www.aionlabs.ai/app/api-keys/
AIONLABS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere - Command R/R+, Aya (multilingüe)
# Registro: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Gemini - 1M contexto, multimodal (texto, imagen, audio, video)
# Registro: https://aistudio.google.com/app/apikey
# NOTA: Free tier solo en EU, UK, Suiza. Ver footnote [1] en data.json
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI - Modelos potentes, free mode $10/mes créditos
# Registro: https://console.mistral.ai/api-keys
# ADVERTENCIA: Free mode usa prompts para entrenar (opt-out disponible)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Z AI (Zhipu AI) - GLM models, 200K contexto
# Registro: https://open.bigmodel.cn/usercenter/apikeys (acepta teléfonos intl)
# Plataforma internacional: https://api.z.ai/api/paas/v4
ZAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# INFERENCE PROVIDERS (Plataformas que hostean modelos open-weight)
# -----------------------------------------------------------------------------

# Cloudflare Workers AI - 75+ modelos, 10K neurons/día
# Requiere: Account ID + API Token
# Registro: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq - Ultra-rápido (LPU), 30 RPM, 1000 RPD
# Registro: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face Inference Router - Miles de modelos, credit-metered ($0.10/mes gratis)
# Registro: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kilo Code - [OPCIONAL] Sin API key requerida (200 req/hr por IP)
# Registro: https://app.kilo.ai/profile (para key opcional)
KILO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM7.io - [OPCIONAL] Tier anónimo turbo (10 RPM, 60 req/hr)
# Registro: https://token.llm7.io (para token gratuito con límites mayores)
LLM7_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ModelScope - Requiere verificación real-name (Alibaba Cloud)
# Registro: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM - 100+ modelos, 40 RPM, 10K RPD (requiere NVIDIA Developer Program)
# Registro: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama Cloud - 16 familias de modelos, límites sesión/semana
# Registro: https://ollama.com/settings/keys
OLLAMA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter - 17 modelos gratuitos (:free), OpenAI-compatible
# Registro: https://openrouter.ai/keys
# TIP: Compra $10+ créditos → 1000 RPD en modelos free
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OVHcloud AI Endpoints - [OPCIONAL] Tier anónimo 2 RPM/IP (EU hosted)
# Registro: https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/
OVH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SiliconFlow - Requiere verificación identidad (docs chinos o contactar soporte)
# Registro: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR (Opcional)
# -----------------------------------------------------------------------------

# Puerto del servidor (default: 8888)
# PORT=8888

# Host (default: 0.0.0.0)
# HOST=0.0.0.0

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Cache TTL en segundos (default: 86400 = 24h)
# CACHE_TTL=86400

# Timeout requests HTTP en segundos (default: 30)
# REQUEST_TIMEOUT=30

# Max reintentos por proveedor (default: 3)
# MAX_RETRIES=3

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. NUNCA subas el .env real a GitHub. Añádelo a .gitignore
# 2. Para Docker: usa --env-file .env o docker-compose env_file
# 3. Proveedores [OPCIONAL] funcionan sin key pero con rate limits bajos
# 4. Verifica footnotes en data.json para restricciones legales/geográficas
# 5. El servidor valida keys al startup y loggea cuáles están configuradas
# =============================================================================